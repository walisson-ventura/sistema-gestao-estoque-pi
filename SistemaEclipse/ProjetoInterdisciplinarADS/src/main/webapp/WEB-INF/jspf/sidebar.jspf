<%@ page language="java" contentType="text/html; charset=UTF-8" pageEncoding="UTF-8"%>
<%@ page import="model.Usuario" %>
<%
    String paginaAtualNav = request.getRequestURI();
    Usuario usuarioNav = (Usuario) session.getAttribute("usuario");
    if (usuarioNav == null) { response.sendRedirect(request.getContextPath()+"/login.jsp"); return; }
    boolean adminNav = "ADMIN".equals(usuarioNav.getPerfil());
    String nomeNav = usuarioNav.getNome() == null ? "Usuário" : usuarioNav.getNome();
%>
<aside class="sidebar">
    <a class="brand" href="<%=request.getContextPath()%>/index.jsp"><span class="brand-icon"><i class="bi bi-box-seam"></i></span><span>Gestão<span class="brand-light">Estoque</span></span></a>
    <div class="sidebar-label">MENU PRINCIPAL</div>
    <nav class="sidebar-nav">
        <a href="<%=request.getContextPath()%>/index.jsp" class="<%=paginaAtualNav.endsWith("index.jsp")?"active":""%>"><i class="bi bi-grid-1x2"></i><span>Início</span></a>
        
        <!-- Menu centralizado de Cadastro (Clientes, Vendedores e aba integrada) -->
        <a href="<%=request.getContextPath()%>/clientes?action=listar" class="<%=paginaAtualNav.endsWith("clientes.jsp")||paginaAtualNav.endsWith("/clientes")?"active":""%>"><i class="bi bi-people"></i><span>Cadastro</span></a>
        
        <!-- Novo módulo de Fornecedores -->
        <a href="<%=request.getContextPath()%>/fornecedores?action=listar" class="<%=paginaAtualNav.endsWith("fornecedores.jsp")||paginaAtualNav.endsWith("/fornecedores")?"active":""%>"><i class="bi bi-truck"></i><span>Fornecedores</span></a>

        <% if(adminNav) { %>
        <a href="<%=request.getContextPath()%>/produtos?action=listar" class="<%=paginaAtualNav.endsWith("produtos.jsp")||paginaAtualNav.endsWith("/produtos")?"active":""%>"><i class="bi bi-box-seam"></i><span>Produtos</span></a>
        <% } %>
        <a href="<%=request.getContextPath()%>/vendas?action=listar" class="<%=paginaAtualNav.endsWith("vendas.jsp")||paginaAtualNav.endsWith("/vendas")?"active":""%>"><i class="bi bi-cart3"></i><span>Vendas</span></a>
        <a href="<%=request.getContextPath()%>/relatorios.jsp" class="<%=paginaAtualNav.endsWith("relatorios.jsp")?"active":""%>"><i class="bi bi-bar-chart-line"></i><span>Relatórios</span></a>
    </nav>
    <div class="sidebar-label sidebar-label-bottom">CONTA</div>
    <nav class="sidebar-nav">
        <a href="<%=request.getContextPath()%>/perfil.jsp"><i class="bi bi-person-circle"></i><span>Meu Perfil</span></a>
        <a href="<%=request.getContextPath()%>/LoginController"><i class="bi bi-box-arrow-right"></i><span>Sair</span></a>
    </nav>
    <div class="sidebar-user"><div class="avatar"><i class="bi bi-person-fill"></i></div><div class="sidebar-user-data"><strong><%=nomeNav.replace("&","&amp;").replace("<","&lt;").replace(">","&gt;")%></strong><small><%=usuarioNav.getPerfil()%></small></div></div>
</aside>